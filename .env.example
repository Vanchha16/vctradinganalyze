APP_NAME=ClaudeTradingAI

APP_ENV=development

APP_DEBUG=true

APP_URL=http://localhost:8000

LOG_LEVEL=INFO

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database

POSTGRES_DB=claudetrading

POSTGRES_USER=claudetrading_user

POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://claudetrading_user:change-me@db:5432/claudetrading

# Redis

REDIS_URL=redis://redis:6379/0

# JWT

JWT_SECRET=change_this_secret

JWT_ALGORITHM=HS256

JWT_ACCESS_EXPIRE_MINUTES=15

JWT_REFRESH_EXPIRE_DAYS=30

# OpenAI

OPENAI_API_KEY=your_api_key

# Telegram

TELEGRAM_BOT_TOKEN=

# Email

SMTP_HOST=

SMTP_PORT=

SMTP_USERNAME=

SMTP_PASSWORD=

# News Provider

NEWS_API_KEY=

# Economic Calendar

ECONOMIC_API_KEY=

# Docker ports

FRONTEND_PORT=3000

BACKEND_PORT=8000

POSTGRES_PORT=5432

REDIS_PORT=6379
