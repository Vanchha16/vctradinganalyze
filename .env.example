APP_NAME=ClaudeTradingAI

APP_ENV=development

APP_DEBUG=true

APP_URL=http://localhost:8000

LOG_LEVEL=INFO

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database

POSTGRES_DB=claudetrading

POSTGRES_USER=claudetrading_user

POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://claudetrading_user:change-me@db:5432/claudetrading

# Redis

REDIS_URL=redis://redis:6379/0

# JWT

JWT_SECRET=change_this_secret

JWT_ALGORITHM=HS256

JWT_ACCESS_EXPIRE_MINUTES=15

JWT_REFRESH_EXPIRE_DAYS=30

# Auth (Phase 8E - docs/59 §9) - public self-registration is closed by
# default. Leave false; accounts are admin-provisioned only
# (POST /admin/users) after the first Super Admin is bootstrapped via
# backend/scripts/create_admin.py.

ALLOW_PUBLIC_REGISTRATION=false

# OpenAI

OPENAI_API_KEY=your_api_key

# Telegram (docs/57)

TELEGRAM_BOT_TOKEN=8994460619:AAFQzbqhRKNxfIt9T6PrmXrM_z8whCl3qeI

TELEGRAM_BOT_USERNAME=@vcbotsignal_bot

# Email

SMTP_HOST=

SMTP_PORT=

SMTP_USERNAME=

SMTP_PASSWORD=

# News Provider

NEWS_API_KEY=

# Economic Calendar

ECONOMIC_API_KEY=

# Market Data - Twelve Data (docs/40, docs/41)

TWELVE_DATA_API_KEY=

# Docker ports

FRONTEND_PORT=3000

BACKEND_PORT=8000

POSTGRES_PORT=5432

REDIS_PORT=6379
