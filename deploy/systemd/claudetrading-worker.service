[Unit]
Description=ClaudeTrading AI Celery Worker
After=network.target postgresql.service redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ClaudeTradingAI/backend
EnvironmentFile=/home/ubuntu/ClaudeTradingAI/backend/.env
ExecStart=/home/ubuntu/ClaudeTradingAI/backend/venv/bin/celery -A app.workers.celery_app.celery_app worker --loglevel=info --concurrency=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
